# Humanovo Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://humanovo:humanovo@localhost:5432/humanovo

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Model Provider Configuration — Mixed routing (model-specific endpoints)
#
# Claude Opus 4.6  → AWS Bedrock (Explorer + Synthesizer)
# DeepSeek-R1-0528 → Azure AI model-specific endpoint (Reasoner)
# Mistral-Large-3  → Azure AI model-specific endpoint (Critic)
# ============================================================================

DISCOVERY_LLM_PROVIDER=azure_ai

# Azure AI — model-specific endpoints (each model has its own URL + key)
# Add these 4 as GitHub Secrets: AZURE_DEEPSEEK_ENDPOINT, AZURE_DEEPSEEK_KEY,
#                                  AZURE_MISTRAL_ENDPOINT, AZURE_MISTRAL_KEY
AZURE_DEEPSEEK_ENDPOINT=
AZURE_DEEPSEEK_KEY=
AZURE_DEEPSEEK_MODEL=DeepSeek-R1-0528

AZURE_MISTRAL_ENDPOINT=
AZURE_MISTRAL_KEY=
AZURE_MISTRAL_MODEL=Mistral-Large-3

# ============================================================================
# AWS Bedrock — Claude Opus 4.6 for Explorer + Synthesizer roles
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_DEEPSEEK=us.deepseek.r1-v1:0
BEDROCK_MODEL_CLAUDE_OPUS=us.anthropic.claude-opus-4-6-v1:0

# ============================================================================
# Azure OpenAI — legacy (optional, kept for backward compatibility)
# ============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Search APIs (optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=

# PubMed (NCBI E-utilities)
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=

# ============================================================================
# Extended Biomedical API Keys
# ============================================================================

# Elsevier Scopus / ScienceDirect — literature search with citation data
# Store as GitHub Actions secret: ELSEVIER_API_KEY
ELSEVIER_API_KEY=

# ============================================================================
# Embedding Grounding Configuration
# Dual-model: Bedrock Cohere Embed v3 (biomedical) + Azure text-embedding-3-large (general)
# ============================================================================
GROUNDING_EMBEDDING_PRIMARY=cohere.embed-english-v3
GROUNDING_EMBEDDING_SECONDARY=azure-text-embedding-3-large
GROUNDING_SIMILARITY_THRESHOLD=0.4
GROUNDING_RAG_TOP_K=8
GROUNDING_GATE_ENABLED=true

# Azure OpenAI Embedding — dedicated endpoint (150K TPM, 900 RPM)
# Resource: humanovo-openai.cognitiveservices.azure.com (shared with Cohere, Kimi, etc.)
# Add as GitHub Secrets: AZURE_EMBEDDING_ENDPOINT, AZURE_EMBEDDING_KEY
AZURE_EMBEDDING_ENDPOINT=https://humanovo-openai.cognitiveservices.azure.com
AZURE_EMBEDDING_KEY=
AZURE_EMBEDDING_API_VERSION=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_LARGE=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_SMALL=text-embedding-3-small

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=change-this-to-a-secure-random-string
