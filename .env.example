# Humanovo Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://humanovo:humanovo@localhost:5432/humanovo

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma
VECTOR_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Azure AI Model Catalog — Non-OpenAI serverless deployments (PRIMARY)
# Deploy from Azure AI Foundry → Model Catalog → Deploy → Serverless API
# Each model gets its own endpoint URL and API key upon deployment
# ============================================================================

# Discovery LLM provider: azure_ai (primary), bedrock (fallback), azure (legacy)
DISCOVERY_LLM_PROVIDER=azure_ai

# Explorer: grok-4 — xAI flagship, broad deep reasoning
AZURE_AI_EXPLORER_ENDPOINT=https://grok-4-xxxxx.eastus2.models.ai.azure.com
AZURE_AI_EXPLORER_KEY=
AZURE_AI_EXPLORER_MODEL=grok-4

# Reasoner: DeepSeek-R1-0528 — state-of-the-art reasoning, formal chain-of-thought
AZURE_AI_REASONER_ENDPOINT=https://DeepSeek-R1-0528-xxxxx.eastus2.models.ai.azure.com
AZURE_AI_REASONER_KEY=
AZURE_AI_REASONER_MODEL=DeepSeek-R1-0528

# Synthesizer: Kimi-K2.5 — large context, multi-source integration
AZURE_AI_SYNTHESIZER_ENDPOINT=https://Kimi-K2-5-xxxxx.eastus2.models.ai.azure.com
AZURE_AI_SYNTHESIZER_KEY=
AZURE_AI_SYNTHESIZER_MODEL=Kimi-K2.5

# Critic: Mistral-Large-3 — strong analytical, cost-efficient
AZURE_AI_CRITIC_ENDPOINT=https://Mistral-Large-3-xxxxx.eastus2.models.ai.azure.com
AZURE_AI_CRITIC_KEY=
AZURE_AI_CRITIC_MODEL=Mistral-Large-3

# ============================================================================
# AWS Bedrock — fallback (if Azure AI unavailable)
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_DEEPSEEK=us.deepseek.r1-v1:0
BEDROCK_MODEL_CLAUDE_OPUS=us.anthropic.claude-opus-4-6-v1:0

# ============================================================================
# Azure OpenAI — legacy (optional, kept for backward compatibility)
# ============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Search APIs (optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=

# PubMed
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=change-this-to-a-secure-random-string
