{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the React app gets at runtime. Tauri v2 ACL — every IPC command the renderer is allowed to invoke must be listed here.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:webview:default",
    "shell:allow-open",
    "deep-link:default",
    "os:default",
    "process:default",
    "updater:default",
    "notification:default",
    "dialog:default"
  ]
}
