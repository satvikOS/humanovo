# ═══════════════════════════════════════════════════════════════
# humanovo — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The 12-stage pipeline requires at MINIMUM:
#   - AWS Bedrock credentials (for Claude Opus/Sonnet + Cohere Embed)
#   - At least ONE Azure model endpoint
# All stages have fallback chains — the pipeline degrades gracefully.
# ═══════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────
APP_NAME=humanovo
VERSION=0.2.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Database (PostgreSQL + pgvector) ────────────────────────
DATABASE_URL=postgresql+asyncpg://humanovo:humanovo@localhost:5432/humanovo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Neo4j (Graph Database) ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ─── AWS Bedrock ─────────────────────────────────────────────
# Required for: Claude Opus 4.6 (SEED), Claude Sonnet 4.6 (EXPAND,
# VALIDATE, TRANSLATE, FINALIZE), Cohere Embed v3 (grounding)
# IAM user needs: bedrock:InvokeModel, bedrock:Converse permissions
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock model IDs (update if newer versions available)
BEDROCK_MODEL_CLAUDE_OPUS=us.anthropic.claude-opus-4-6-v1:0
BEDROCK_MODEL_CLAUDE_SONNET=us.anthropic.claude-sonnet-4-20250514-v1:0

# ─── Azure OpenAI — GPT-4o (Stage 10: REFINE) ───────────────
# Deployment type: Azure OpenAI dedicated resource
AZURE_GPT4O_ENDPOINT=https://your-resource.openai.azure.com
AZURE_GPT4O_KEY=
AZURE_GPT4O_DEPLOYMENT=gpt-4o
AZURE_GPT4O_API_VERSION=2024-11-20

# ─── Azure OpenAI — GPT-4.1 (Stage 6: MECHANISM, Stage 9: SCORE)
AZURE_GPT41_ENDPOINT=https://your-resource.openai.azure.com
AZURE_GPT41_KEY=
AZURE_GPT41_DEPLOYMENT=gpt-4.1
AZURE_GPT41_API_VERSION=2024-05-01-preview

# ─── Azure OpenAI — o3-mini (Stage 5: REVISE) ───────────────
# Reasoning model — 2.5M TPM / 250 RPM
AZURE_O3MINI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_O3MINI_KEY=
AZURE_O3MINI_DEPLOYMENT=o3-mini
AZURE_O3MINI_API_VERSION=2024-05-01-preview

# ─── Azure OpenAI — Cohere Command A (Stage 3: EVIDENCE) ────
AZURE_COHERE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_COHERE_KEY=
AZURE_COHERE_DEPLOYMENT=cohere-command-a
AZURE_COHERE_API_VERSION=2024-05-01-preview

# ─── Azure AI — Mistral-Large-3 (Stage 4: COUNTER) ──────────
# Model-specific endpoint (not Foundry shared endpoint)
AZURE_MISTRAL_ENDPOINT=https://your-mistral-endpoint.eastus2.models.ai.azure.com/v1
AZURE_MISTRAL_KEY=
AZURE_MISTRAL_MODEL=Mistral-Large-3

# ─── Azure AI — Grok (Stage 8: GROUND) ──────────────────────
# Azure AI Foundry shared endpoint
AZURE_GROK_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_GROK_KEY=
AZURE_GROK_MODEL=grok-4-1-fast-reasoning

# ─── Azure OpenAI — Embeddings (Grounding Secondary) ────────
# Deployment: text-embedding-3-large (1536d)
# Used as secondary embedding in dual-model grounding
AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com
AZURE_EMBEDDING_KEY=
AZURE_EMBEDDING_API_VERSION=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_LARGE=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_SMALL=text-embedding-3-small

# ─── Azure OpenAI — Legacy (backward compat, can be empty) ──
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Discovery Pipeline Configuration ───────────────────────
DISCOVERY_LLM_PROVIDER=azure_ai
DISCOVERY_MAX_EVIDENCE_CHUNKS=50
DISCOVERY_MAX_GRAPH_PATHS=100
DISCOVERY_MIN_CONFIDENCE=0.3

# ─── Grounding Configuration ────────────────────────────────
GROUNDING_EMBEDDING_PRIMARY=cohere.embed-english-v3
GROUNDING_EMBEDDING_SECONDARY=azure-text-embedding-3-large
GROUNDING_SIMILARITY_THRESHOLD=0.4
GROUNDING_RAG_TOP_K=8
GROUNDING_GATE_ENABLED=true

# ─── Parallel MCP Configuration ─────────────────────────────
MCP_ENABLED=true
MCP_MAX_CONTEXT_PER_MODEL=128000
MCP_CONTEXT_OVERLAP=2000
MCP_PARALLEL_SHARDS=4
MCP_SYNTHESIS_MODEL=us.anthropic.claude-opus-4-6-v1:0
MCP_CHUNK_STRATEGY=semantic

# ─── Token Pool Management ──────────────────────────────────
TOKEN_POOL_MAX_CONCURRENT_REQUESTS=200
TOKEN_POOL_MAX_TOKENS_PER_MINUTE=2000000
TOKEN_POOL_RETRY_BACKOFF_BASE=1.5
TOKEN_POOL_RETRY_MAX_ATTEMPTS=5

# ─── Biomedical Data Source APIs ─────────────────────────────
PUBMED_EMAIL=your-email@institution.edu
PUBMED_API_KEY=
PUBMED_RATE_LIMIT=10

ELSEVIER_API_KEY=
# Web-search backends (Brave, Google) removed for v1; v1 grounds in open
# biomedical sources only. See docs/planning/SOURCES_ROADMAP.md.

# ─── Security ───────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
